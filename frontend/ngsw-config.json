{
	"$schema": "./node_modules/@angular/service-worker/config/schema.json",
	"index": "/index.html",
	"assetGroups": [
		{
			"name": "app",
			"installMode": "prefetch",
			"resources": {
				"files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
			}
		},
		{
			"name": "assets",
			"installMode": "lazy",
			"updateMode": "prefetch",
			"resources": {
				"files": ["/assets/**"]
			}
		},
		{
			"name": "vendor",
			"installMode": "lazy",
			"updateMode": "prefetch",
			"resources": {
				"urls": ["https://fonts.googleapis.com/css?family=Roboto:400,700&display=swap"]
			}
		}
	]
}
