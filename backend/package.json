{
  "name": "@bosancz/bosancz-interni-backend",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:watch": "nest build --watch",
    "start": "node dist/main.js",
    "start:dev": "npm run dev",
    "dev": "nest start --debug --watch --preserveWatchOutput",
    "cli": "node dist/main-cli",
    "upgrade:check": "npx npm-check-updates",
    "upgrade": "npx npm-check-updates -u && npm install",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d ./src/database/data-source.ts",
    "migrations:generate": "npm run typeorm migration:generate ./src/database/migrations/$npm_config_name",
    "migrations:create": "npm run typeorm migration:create ./src/database/migrations/$npm_config_name",
    "migrations:run": "npm run typeorm migration:run",
    "migrations:revert": "npm run typeorm migration:revert",
    "migrations:drop-schema": "npm run typeorm schema:drop",
    "migrations:reset": "npm run migrations:drop-schema && npm run migrations:run"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@octokit/auth-app": "^7.2.2",
    "@octokit/rest": "^21.1.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "change-case": "^5.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exif-reader": "^2.0.3",
    "google-auth-library": "^10.9.0",
    "googleapis": "^169.0.0",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "marked": "^15.0.12",
    "mime-types": "^3.0.2",
    "mongoose": "^8.10.0",
    "nest-commander": "^3.20.1",
    "pg": "^8.16.3",
    "puppeteer": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.0",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0",
    "typescript-eslint": "^8.52.0",
    "write-excel-file": "^2.3.10",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/hbs": "^4.0.5",
    "@types/jest": "30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.10",
    "@types/xlsx-populate": "github:JanLoebel/types-xlsx-populate",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "30.2.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
